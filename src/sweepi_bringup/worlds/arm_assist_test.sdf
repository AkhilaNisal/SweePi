      </link>
    </model>
    <model name='wall_east'>
      <static>true</static>
      <pose>2.5 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.1 5 1</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.1 5 1</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
