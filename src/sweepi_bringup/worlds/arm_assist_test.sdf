    </model>

    <model name='low_under_object_bar'>
      <static>true</static>
      <pose>0.85 0.0 0.20 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.70 0.10 0.16</size></box></geometry>
        </collision>
