<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="front_tof_length" value="0.030"/>
  <xacro:property name="front_tof_width"  value="0.024"/>
  <xacro:property name="front_tof_height" value="0.020"/>

  <xacro:macro name="front_tof_box_inertia" params="m x y z o_xyz o_rpy">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
      <inertia
        ixx="${m * (y * y + z * z) / 12.0}" ixy="0" ixz="0"
        iyy="${m * (x * x + z * z) / 12.0}" iyz="0"
        izz="${m * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="front_tof_link">
    <visual>
      <geometry>
        <box size="${front_tof_length} ${front_tof_width} ${front_tof_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${front_tof_length} ${front_tof_width} ${front_tof_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <xacro:front_tof_box_inertia
      m="0.02"
      x="${front_tof_length}"
      y="${front_tof_width}"
      z="${front_tof_height}"
      o_xyz="0 0 0"
      o_rpy="0 0 0"/>
  </link>

  <joint name="base_front_tof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_tof_link"/>
    <origin xyz="${body_radius + front_tof_length / 2.0} 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_tof_link">
    <sensor name="front_tof" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/tof/front/scan</topic>
      <update_rate>20</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>1.20</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>0</visualize>
    </sensor>
  </gazebo>

</robot>
