<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sweepi_robot_manager</name>
  <version>0.1.0</version>
  <description>Top-level launch and command manager for the SweePi robot.</description>
  <maintainer email="wedamestrigean@gmail.com">akhila-wedamestrige</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <depend>sweepi_robot_manager_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sweepi_bringup</exec_depend>
  <exec_depend>sweepi_exploration</exec_depend>
  <exec_depend>sweepi_coverage</exec_depend>
  <exec_depend>sweepi_api_bridge</exec_depend>
  <exec_depend>sweepi_real_bringup</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
