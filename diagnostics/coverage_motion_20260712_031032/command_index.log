===== living_room_map_analysis =====
$ bash -lc cd /home/sweepi/SweePi && python3 - <<"PY"
import math, yaml
from pathlib import Path
p=Path("maps/living_room.yaml")
print(p.read_text())
meta=yaml.safe_load(p.read_text())
img=(p.parent/meta["image"]).resolve()
print("image", img)
raw=img.read_bytes()
# parse PGM P5/P2
idx=0
def token():
    global idx
    while raw[idx:idx+1].isspace(): idx+=1
    if raw[idx:idx+1]==b"#":
        while raw[idx:idx+1] not in (b"\n", b""): idx+=1
        return token()
    j=idx
    while idx < len(raw) and not raw[idx:idx+1].isspace(): idx+=1
    return raw[j:idx]
magic=token(); w=int(token()); h=int(token()); maxv=int(token())
while raw[idx:idx+1].isspace(): idx+=1
data=list(raw[idx:idx+w*h]) if magic==b"P5" else []
print("magic",magic,"w",w,"h",h,"max",maxv,"len",len(data))
res=float(meta["resolution"]); ox,oy,oyaw=map(float, meta["origin"])
# map_server trinary default: occupied if occ>occ_thresh, free if occ<free_thresh, else unknown. For negate=0 occ=(255-p)/255.
free=[]; occ=[]; unk=[]
free_thresh=float(meta.get("free_thresh",0.196)); occ_thresh=float(meta.get("occupied_thresh",0.65)); negate=int(meta.get("negate",0))
for y in range(h):
  for x in range(w):
    pix=data[y*w+x]
    occprob=(pix/255.0 if negate else (255-pix)/255.0)
    if occprob > occ_thresh: occ.append((x,y))
    elif occprob < free_thresh: free.append((x,y))
    else: unk.append((x,y))
print("counts free occ unk",len(free),len(occ),len(unk))
# API reported cell for 0,0; find nearest free to 0,0 and candidates around center
def world(x,y): return (ox+(x+0.5)*res, oy+(h-y-0.5)*res)  # ROS map y? Need compare API may not invert; print both
mx=int((0-ox)/res); my=int((0-oy)/res)
print("cell no invert for 0,0",mx,my,"pix",data[my*w+mx] if 0<=mx<w and 0<=my<h else None)
# API reported my 163, check world with no invert formula used by map_store likely oy+my*res
for cx,cy in [(mx,my),(144,163)]:
  if 0<=cx<w and 0<=cy<h:
    print("cell",cx,cy,"pix",data[cy*w+cx],"world_noinv",(ox+(cx+0.5)*res, oy+(cy+0.5)*res),"world_invert",world(cx,cy))
nearest=sorted(free, key=lambda c:(ox+(c[0]+0.5)*res)**2 + (oy+(c[1]+0.5)*res)**2)[:20]
for c in nearest[:10]:
  wx=ox+(c[0]+0.5)*res; wy=oy+(c[1]+0.5)*res
  print("nearest_free_noinv",c,"world",round(wx,3),round(wy,3),"dist",round(math.hypot(wx,wy),3),"pix",data[c[1]*w+c[0]])
PY
