import yaml, math, pathlib, subprocess, json, re
from PIL import Image
mp=pathlib.Path("maps/living_room.yaml")
y=yaml.safe_load(mp.read_text())
img_path=mp.parent / y["image"]
img=Image.open(img_path).convert("L")
w,h=img.size
res=float(y["resolution"]); ox,oy,oth=map(float,y["origin"])
points=[(-0.2790927082423762,-0.6504112580713652),(-0.129,0.1),(0,0),(-0.25908158,-0.64557917)]
print("map", img_path, "size", w,h,"res",res,"origin",ox,oy)
for x,yy in points:
    cx=math.floor((x-ox)/res); cy=math.floor((yy-oy)/res)
    img_y=h-1-cy
    pix=img.getpixel((cx,img_y)) if 0<=cx<w and 0<=img_y<h else None
    print("world",x,yy,"cell",cx,cy,"img_y",img_y,"pixel",pix)
# dump first few path points from API and sample pixels
import urllib.request
raw=urllib.request.urlopen("http://localhost:8080/api/cleaning/path").read().decode()
data=json.loads(raw)
pts=data.get("points") or []
print("api points",len(pts),"signature",data.get("path_signature"))
counts={"free":0,"occ":0,"unknown":0,"other":0,"out":0}
for p in pts[:200]:
    x=float(p.get("x",0)); yy=float(p.get("y",0))
    cx=math.floor((x-ox)/res); cy=math.floor((yy-oy)/res); img_y=h-1-cy
    if not(0<=cx<w and 0<=img_y<h): counts["out"]+=1; continue
    pix=img.getpixel((cx,img_y))
    # map_server trinary default: 255 free, 0 occ, 205 unknown usually
    if pix > 250: counts["free"]+=1
    elif pix < 10: counts["occ"]+=1
    elif 120 <= pix <= 140 or 200 <= pix <= 210: counts["unknown"]+=1
    else: counts["other"]+=1
print("first200 image pixel buckets",counts)
for p in pts[:10]:
    x=float(p.get("x",0)); yy=float(p.get("y",0)); cx=math.floor((x-ox)/res); cy=math.floor((yy-oy)/res); img_y=h-1-cy
    pix=img.getpixel((cx,img_y)) if 0<=cx<w and 0<=img_y<h else None
    print("pt",round(x,3),round(yy,3),"cell",cx,cy,"pix",pix)
