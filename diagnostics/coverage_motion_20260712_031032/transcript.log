coverage_tracker_node:
  ros__parameters:
    use_sim_time: true
    global_frame: map
    robot_base_frame: base_footprint
    robot_radius_m: 0.20
    occupied_threshold: 50
    coverage_update_rate_hz: 8.0
    coverage_topic: /coverage_map

coverage_planner_node:
  ros__parameters:
    use_sim_time: true
    coverage_map_topic: "/coverage_map"
    nav_costmap_topic: "/global_costmap/costmap"
    coverage_path_topic: "/coverage_path"
    planning_mask_topic: "/coverage_planning_mask"
    coverage_percentage_topic: "/coverage_percentage"
    coverage_stats_topic: "/coverage_stats"
    coverage_cell_value: 50
    robot_radius_m: 0.20
    coverage_safety_margin_m: 0.10
    coverage_spacing_m: 0.25  # change from 0.25 m
    min_segment_length_m: 0.30
    inflation_radius_m: 0.24
    min_region_area_m2: 0.20
    path_publish_rate_hz: 1.0
    planning_direction: "auto"
    publish_debug_mask: true
    publish_debug_markers: true
    replan_on_map_change: false
    republish_last_path: true
    freeze_path_after_first_valid_plan: true
    connect_disjoint_segments: true
    connector_step_m: 0.10
    max_consecutive_pose_jump_m: 0.50
    connector_check_obstacles: true
    connector_allow_simple_straight_line: true
    optimize_segment_order: true
    allow_segment_reversal: true
    start_near_robot_if_tf_available: true
    debug_path_continuity: true
    use_nav_costmap_for_planning: true
    use_global_costmap_for_planning: true
    max_allowed_nav_cost: 85
    treat_unknown_cost_as_blocked: true
    nav_costmap_timeout_sec: 2.0
