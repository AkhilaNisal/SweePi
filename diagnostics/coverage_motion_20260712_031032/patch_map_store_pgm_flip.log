===== patch_map_store_pgm_flip =====
$ bash -lc python3 - <<"PY"
from pathlib import Path
path = Path("src/sweepi_api_bridge/sweepi_api_bridge/map_store.py")
text = path.read_text()
old = """        occupancy = []\n        for pixel in image[pixels]:\n            value = 255 - pixel if negate else pixel\n            occ = (255 - value) / 255.0\n            if occ > occupied_thresh:\n                occupancy.append(100)\n            elif occ < free_thresh:\n                occupancy.append(0)\n            else:\n                occupancy.append(-1)\n"""
new = """        occupancy = []\n        width = image[width]\n        height = image[height]\n        # PGM map images are stored top row first, while ROS OccupancyGrid\n        # data is indexed from the map origin at the bottom-left.\n        for row in range(height - 1, -1, -1):\n            start = row * width\n            for pixel in image[pixels][start:start + width]:\n                value = 255 - pixel if negate else pixel\n                occ = (255 - value) / 255.0\n                if occ > occupied_thresh:\n                    occupancy.append(100)\n                elif occ < free_thresh:\n                    occupancy.append(0)\n                else:\n                    occupancy.append(-1)\n"""
if old not in text:
    raise SystemExit("target block not found")
path.write_text(text.replace(old, new))
PY
