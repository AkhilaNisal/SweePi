===== command_topic_counts =====
$ bash -lc python3 - <<"PY"
import time
import rclpy
from geometry_msgs.msg import Twist
from std_msgs.msg import String
counts={"/cmd_vel":0,"/cmd_vel_nav":0,"/sweepi_robot_manager/status":0}
last={}
def cb(topic, msg):
    counts[topic]+=1
    last[topic]=str(msg)[:300].replace("\n"," ")
    if topic.startswith("/cmd_vel"):
        print(f"{time.time():.3f} {topic} linear.x={msg.linear.x:.4f} angular.z={msg.angular.z:.4f}", flush=True)
    else:
        print(f"{time.time():.3f} {topic} {last[topic]}", flush=True)
rclpy.init()
node=rclpy.create_node("diagnostic_command_counts")
node.create_subscription(Twist,"/cmd_vel",lambda m: cb("/cmd_vel",m),10)
node.create_subscription(Twist,"/cmd_vel_nav",lambda m: cb("/cmd_vel_nav",m),10)
node.create_subscription(String,"/sweepi_robot_manager/status",lambda m: cb("/sweepi_robot_manager/status",m),10)
end=time.time()+6
while time.time()<end and rclpy.ok():
    rclpy.spin_once(node,timeout_sec=0.2)
print("SUMMARY "+" ".join(f"{k}={v}" for k,v in counts.items()), flush=True)
for k,v in last.items(): print(f"LAST {k}: {v}", flush=True)
node.destroy_node(); rclpy.shutdown()
PY
exit=0

