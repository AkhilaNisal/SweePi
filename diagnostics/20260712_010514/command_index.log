===== live_map_stats =====
$ bash -lc python3 - <<"PY"
import hashlib, time
import rclpy
from nav_msgs.msg import OccupancyGrid

samples = {"/map": [], "/slam_map": []}

def summarize(topic, msg):
    data = bytes((v & 0xff for v in msg.data))
    unknown = sum(1 for v in msg.data if v < 0)
    free = sum(1 for v in msg.data if v == 0)
    occupied = sum(1 for v in msg.data if v > 0)
    stamp = msg.header.stamp.sec + msg.header.stamp.nanosec / 1e9
    digest = hashlib.sha256(data).hexdigest()[:16]
    print(f"{time.time():.3f} {topic} stamp={stamp:.3f} frame={msg.header.frame_id} size={msg.info.width}x{msg.info.height} res={msg.info.resolution} unknown={unknown} free={free} occupied={occupied} sha16={digest}", flush=True)
    samples[topic].append(digest)

rclpy.init()
node = rclpy.create_node("diagnostic_map_stats")
for topic in samples:
    node.create_subscription(OccupancyGrid, topic, lambda msg, t=topic: summarize(t, msg), 10)
end = time.time() + 10
while time.time() < end and rclpy.ok():
    rclpy.spin_once(node, timeout_sec=0.2)
for topic, vals in samples.items():
    print(f"SUMMARY {topic}: messages={len(vals)} unique_hashes={len(set(vals))}", flush=True)
node.destroy_node()
rclpy.shutdown()
PY
exit=0

