#!/usr/bin/env bash
set -euo pipefail

source {{ sweepi_config_root }}/restic.env

EXCLUDES=(
{% for path in sweepi_backup_excludes %}
  --exclude={{ path | quote }}
{% endfor %}
)

restic snapshots >/dev/null 2>&1 || restic init

restic backup \
{% for path in sweepi_backup_paths %}
  {{ path | quote }} \
{% endfor %}
  "${EXCLUDES[@]}" \
  --tag sweepi-rpi

restic forget \
  --tag sweepi-rpi \
  --keep-hourly 12 \
  --keep-daily 7 \
  --keep-weekly 4 \
  --keep-monthly 6 \
  --prune
